# ===== Docker Registry Configuration =====
# Docker registry where images will be pushed
DOCKER_REGISTRY=docker.platform.dev.nuxeo.com

# Base/benchmark image names are derived from DOCKER_REGISTRY by default (see
# Makefile/Taskfile). Uncomment below only to override with a literal value —
# shell-style ${VAR} interpolation is NOT evaluated in this file.
# DOCKER_BASE_IMAGE_NAME=docker.platform.dev.nuxeo.com/nuxeo/nuxeo
# DOCKER_BENCHMARK_IMAGE_NAME=docker.platform.dev.nuxeo.com/nuxeo/nuxeo-benchmark

# ===== Image Version Configuration =====
# Docker image tag (e.g., 2025.x, 2025.9, latest)
DOCKER_IMAGE_TAG=2025.x

# Maven revision for the build
REVISION=2025.x-SNAPSHOT

# Version label for the Docker image
VERSION=2025.x

# ===== Build Configuration =====
# Build tag for tracking builds
BUILD_TAG=local

# Git commit reference (usually auto-detected)
# SCM_REF=abc123def

# Platform to build for (linux/amd64 or linux/arm64). Auto-detected from your system
# architecture by default (e.g. native linux/arm64 on Apple Silicon) — uncomment to
# cross-build via QEMU emulation instead (QEMU must be registered with your container
# engine; podman machine has this enabled by default).
# DOCKER_PLATFORM=linux/amd64

# Platform passed to `push-*-platform` targets; defaults to DOCKER_PLATFORM above.
# Only set this if you need to push a different platform tag than you built.
# TARGETPLATFORM=linux/amd64

# ===== Maven Configuration =====
# Maven JVM options
MAVEN_OPTS=-Xmx4g -Xms2g -XX:+TieredCompilation -XX:TieredStopAtLevel=1

# Java home — Makefile auto-detects JAVA_HOME from `javac` on PATH by default;
# Taskfile derives it from JAVA_VERSION below. Uncomment JAVA_HOME only if you need
# to override it explicitly, using an absolute path (no `~` — it is not expanded here).
JAVA_VERSION=21.0.2-tem
# JAVA_HOME=/absolute/path/to/.sdkman/candidates/java/21.0.2-tem

# ===== Docker Authentication (if needed) =====
# If you need to authenticate to Docker registry, you can set these
DOCKER_USERNAME=your-username
DOCKER_PASSWORD=your-password

# ===== Maven Artifact Deployment (`task deploy`) =====
# Maven server/repository id. Must match a <server><id> entry in ~/.m2/settings.xml
# that provides the credentials for DISTRIBUTION_URL below.
DISTRIBUTION_ID=your-repo-id
# Maven repository URL to deploy the distribution artifacts to.
DISTRIBUTION_URL=https://your-repo-manager.example.com/repository/maven-releases/

# ===== Development Overrides =====
# Uncomment and modify these for local development

# Use a local registry for testing
# DOCKER_REGISTRY=localhost:5000

# Use custom image names
# DOCKER_BASE_IMAGE_NAME=mycompany/nuxeo
# DOCKER_BENCHMARK_IMAGE_NAME=mycompany/nuxeo-benchmark

# Use a specific version
# DOCKER_IMAGE_TAG=dev
# REVISION=2025.9-SNAPSHOT
